# News Aggregator Configuration

# Application Settings
APP_NAME="News Aggregator"
DEBUG=False
LOG_LEVEL=INFO

# Storage Settings
# Options: 'file' or 'database'
STORAGE_TYPE=file

# File Storage
NEWS_MD_DIR=news_md

# Database Storage (optional - only needed if STORAGE_TYPE=database)
# Examples:
# PostgreSQL: postgresql://user:password@localhost:5432/newsdb
# MySQL: mysql+pymysql://user:password@localhost:3306/newsdb
# SQLite: sqlite:///news.db
#DATABASE_URL=

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# HTTP Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.0

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=3600

# News Fetching
MAX_ARTICLES_PER_SOURCE=50
FETCH_POLITICAL_ONLY=True

# Enabled Sources (comma-separated)
# Available: newsapi,guardian,nyt,bbc,reuters,ap,politico,the_hill,npr,cnn,abc,cbs,nbc,pbs,washington_post,the_atlantic,propublica
#ENABLED_SOURCES=newsapi,guardian,nyt,bbc,reuters,politico,the_hill,npr,cnn,abc,cbs,nbc,pbs,washington_post,the_atlantic,propublica

# Credential Storage
# Leave empty to use default (~/.news_aggregator/credentials.enc)
#CREDENTIAL_STORAGE_PATH=

# =============================================================================
# API CREDENTIALS
# =============================================================================
# You have two options for providing API credentials:
# 1. Set them here as environment variables (uncomment and fill in)
# 2. Use the GUI credential manager (run: python main.py --setup-credentials)
#
# Environment variables take priority over GUI-stored credentials.
#
# =============================================================================

# -----------------------------------------------------------------------------
# NewsAPI - https://newsapi.org/register
# -----------------------------------------------------------------------------
# Free tier: 100 requests/day
# Provides: 80,000+ news sources worldwide
# How to get:
#   1. Go to https://newsapi.org/register
#   2. Enter your email and password
#   3. Click "Submit"
#   4. Copy your API key from the confirmation page or dashboard
#
NEWSAPI_API_KEY=a72136099def408abaeb6a988aba62ed

# -----------------------------------------------------------------------------
# The Guardian - https://open-platform.theguardian.com/access
# -----------------------------------------------------------------------------
# Free tier: 5,000 requests/day, 12 requests/second
# Provides: The Guardian content dating back to 1999
# How to get:
#   1. Go to https://open-platform.theguardian.com/access
#   2. Fill in your name, email, and reason for access
#   3. Click "Register"
#   4. Check your email for the API key
#
GUARDIAN_API_KEY=3c7b4108-327a-4763-9808-e189253a750c

# -----------------------------------------------------------------------------
# New York Times - https://developer.nytimes.com/get-started
# -----------------------------------------------------------------------------
# Free tier: 500 requests/day, 5 requests/minute
# Provides: NYT articles (metadata only, not full text)
# How to get:
#   1. Go to https://developer.nytimes.com/get-started
#   2. Click "Get Started" or "Sign Up"
#   3. Create a NYT Developer account
#   4. Go to "My Apps" and create a new app
#   5. Enable the APIs you want (Top Stories, Article Search, etc.)
#   6. Copy your API key
#
NYT_API_KEY=PiG29wSMFZx5L41KHtQ3edfuCIhWJVKr

# =============================================================================
# NOTE: 14 additional sources work via RSS without any API keys:
# BBC, Reuters, AP, Politico, The Hill, NPR, CNN, ABC News, CBS News,
# NBC News, PBS NewsHour, Washington Post, The Atlantic, ProPublica
# =============================================================================
